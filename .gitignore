# 操作系统和 IDE 生成的本地文件。
.DS_Store
.idea/

# Python 虚拟环境、测试缓存和字节码。
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Node.js 依赖可通过包管理器重新安装。
node_modules

# 本地环境变量可能包含凭据；保留可公开的示例文件。
.env
.env.*
!.env.example

# 管材检测的原始数据、生成结果和调试图片不进入 Git 历史。
/tube_inspection/datas/
/tube_inspection/results/
/tube_inspection/example_results/
/tube_inspection/process_debug_output/
